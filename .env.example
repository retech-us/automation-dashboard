# Test Case Creator Plugin - Environment Variables Example
# Copy this to .env and fill in your actual values
# DO NOT COMMIT .env FILE - IT CONTAINS SECRETS!

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token-here

# AI Model Configuration (choose one)
# Option 1: Anthropic/Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Option 2: OpenAI (fallback if ANTHROPIC_API_KEY not set)
# OPENAI_API_KEY=sk-your-openai-key-here

# Plugin Configuration
TEST_CASE_CREATOR_ENABLED=true
GENERATION_MODEL=claude-3-5-sonnet-20241022
MAX_ISSUES_PER_RUN=50
MAX_ATTACHMENT_SIZE_MB=10

# Debugging
DEBUG=false
